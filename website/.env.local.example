# Copy this file to .env.local and fill in the real values from your
# Supabase project (Project Settings → API).
# The .env.local file is gitignored so secrets never leave your machine.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxx

# Server-only. NEVER commit. Used by the seed script and admin server actions.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxx
